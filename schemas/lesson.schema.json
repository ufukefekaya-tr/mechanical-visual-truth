{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "rule", "scores", "evidence", "regression"],
  "properties": {
    "id": {"type": "string"}, "rule": {"type": "string"}, "scope": {"type": "string"},
    "scores": {
      "type": "object",
      "required": ["severity", "evidence_quality", "reproducibility", "independent_recurrence", "generality", "regression_strength"],
      "properties": {
        "severity": {"type": "integer", "minimum": 0, "maximum": 25},
        "evidence_quality": {"type": "integer", "minimum": 0, "maximum": 25},
        "reproducibility": {"type": "integer", "minimum": 0, "maximum": 20},
        "independent_recurrence": {"type": "integer", "minimum": 0, "maximum": 15},
        "generality": {"type": "integer", "minimum": 0, "maximum": 10},
        "regression_strength": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "evidence": {"type": "array", "minItems": 1}, "regression": {"type": "object"},
    "status": {"enum": ["CANDIDATE", "PROMOTED", "QUARANTINED", "ROLLED_BACK"]}
  }
}
